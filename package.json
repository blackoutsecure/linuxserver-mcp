    },
    {
      "type": "other",
      "url": "https://blackoutsecure.app"
    }
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.24.2"
  },
