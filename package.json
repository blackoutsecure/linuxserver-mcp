{
  "name": "@blackoutsecure/linuxserver-mcp-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "build": "npm run build --workspace=@blackoutsecure/linuxserver-mcp && npm run build --workspace=@blackoutsecure/linuxserver-mcp-worker && npm run build --workspace=@blackoutsecure/linuxserver-mcp-web",
    "dev": "npm run dev --workspace=@blackoutsecure/linuxserver-mcp-web",
    "start": "npm run start --workspace=@blackoutsecure/linuxserver-mcp",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "pretest": "npm run build --workspace=@blackoutsecure/linuxserver-mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "npm run lint && npm run typecheck && npm run build && npm test",
    "release:pack": "npm pack --workspace=@blackoutsecure/linuxserver-mcp --dry-run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
